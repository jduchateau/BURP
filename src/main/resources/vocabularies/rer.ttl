@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dc:   <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rer:  <http://w3id.org/rml/report#> .

rer:
    a          owl:Ontology ;
    dc:title   "RML Execution Report (RER) Vocabulary"@en ;
    dc:description
               "Vocabulary for describing reports, statistics, execution plans and error/warning information produced by RML processors."@en ;
    dc:date    "2025-11-18"^^xsd:date ;
    dc:creator "Jakub Duchateau" .

rer:RmlExecutionReport
    a                rdfs:Class ;
    rdfs:label       "RML Execution Report" ;
    rdfs:comment     "A report generated by an RML Processor." ;
    rdfs:isDefinedBy rer: .

rer:isSuccess
    a                rdf:Property ;
    rdfs:label       "the overall success, equivalent to the exit code 0, did we encounter any kind of errors." ;
    rdfs:domain      rer:RmlExecutionReport ;
    rdfs:range       xsd:boolean .

rer:isComplete
    a               rdfs:Property;
    rdfs:label "Are the output datasets complete.";
    rdfs:domain rer:RmlExecutionReport;
        rdfs:range xsd:boolean.

rer:hasStatistics
    a                rdf:Property ;
    rdfs:label       "has statistics" ;
    rdfs:domain      rer:RmlEngineReport ;
    rdfs:range       rer:Statistics ;
    rdfs:isDefinedBy rer: .

rer:hasExecutionPlan
    a                rdf:Property ;
    rdfs:label       "has execution plan" ;
    rdfs:domain      rer:RmlEngineReport ;
    rdfs:range       rer:ExecutionPlan ;
    rdfs:isDefinedBy rer: .

rer:numberOfTriplesMap
    a                rdf:Property ;
    rdfs:label       "number of triples per Triples Map" ;
    rdfs:comment     "Indicate how many Triples Map were found in the RML mapping document."@en ;
    rdfs:domain      rer:ExecutionPlan ;
    rdfs:range       xsd:positiveInteger ;
    rdfs:isDefinedBy rer: .

rer:hasError
    a                rdf:Property ;
    rdfs:label       "has error" ;
    rdfs:domain      rer:RmlEngineReport ;
    rdfs:range       rer:Error ;
    rdfs:isDefinedBy rer: .

rer:hasWarning
    a                rdf:Property ;
    rdfs:label       "has warning" ;
    rdfs:domain      rer:RmlEngineReport ;
    rdfs:range       rer:Warning ;
    rdfs:isDefinedBy rer: .

rer:Statistics
    a                rdfs:Class ;
    rdfs:label       "Statistics" ;
    rdfs:comment     "Statistics about the RML processor execution." ;
    rdfs:isDefinedBy rer: .

rer:generatedStatements
    a                rdf:Property ;
    rdfs:label       "generated statements" ;
    rdfs:domain      rer:Statistics ;
    rdfs:range       xsd:integer ;
    rdfs:isDefinedBy rer: .

rer:generatedStatementsPerTarget
    a                rdf:Property ;
    rdfs:label       "generated statements per target" ;
    rdfs:domain      rer:Statistics ;
    rdfs:range       xsd:integer ;
    rdfs:isDefinedBy rer: .

rer:generatedStatementsPerTM
    a                rdf:Property ;
    rdfs:label       "generated statements per Triples Map" ;
    rdfs:domain      rer:Statistics ;
    rdfs:range       xsd:integer ;
    rdfs:isDefinedBy rer: .

rer:ExecutionPlan
    a                rdfs:Class ;
    rdfs:label       "Execution Plan" ;
    rdfs:comment     "The execution plan used by the RML processor." ;
    rdfs:isDefinedBy rer: .


rer:message
    a                rdf:Property ;
    rdfs:label       "message" ;
    rdfs:comment     "Human-readable message associated with an error or a warning." ;
    rdfs:domain      rer:Error, rer:Warning ;
    rdfs:range       rdfs:Literal ;
    rdfs:isDefinedBy rer: .

rer:potentialCause
    a                rdf:Property ;
    rdfs:label       "potential cause" ;
    rdfs:domain      rer:Error ;
    rdfs:range       rdfs:Literal ;
    rdfs:isDefinedBy rer: .

rer:potentialSolution
    a                rdf:Property ;
    rdfs:label       "potential solution" ;
    rdfs:domain      rer:Error ;
    rdfs:range       rdfs:Literal ;
    rdfs:isDefinedBy rer: .

rer:potentialConfusion
    a                rdf:Property ;
    rdfs:label       "potential confusion" ;
    rdfs:domain      rer:Error ;
    rdfs:range       rdfs:Literal ;
    rdfs:isDefinedBy rer: .

rer:hasSourceNode
    a                rdf:Property ;
    rdfs:label       "has source node" ;
    rdfs:domain      rer:Error ;
    rdfs:range       rdf:Resource ;
    rdfs:isDefinedBy rer: .

rer:hasMappingNode
    a                rdf:Property ;
    rdfs:label       "has mapping node" ;
    rdfs:domain      rer:Error ;
    rdfs:range       rdf:Resource ;
    rdfs:isDefinedBy rer: .

rer:lineNumber
    a                rdf:Property ;
    rdfs:label       "line number" ;
    rdfs:domain      rer:Error ;
    rdfs:range       xsd:integer ;
    rdfs:isDefinedBy rer: .

rer:colNumber
    a                rdf:Property ;
    rdfs:label       "column number" ;
    rdfs:domain      rer:Error ;
    rdfs:range       xsd:integer ;
    rdfs:isDefinedBy rer: .

rer:hasSourceData
    a                rdf:Property ;
    rdfs:label       "has source data" ;
    rdfs:domain      rer:Error ;
    rdfs:range       rdfs:Literal ;
    rdfs:isDefinedBy rer: .
