@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rep: <http://w3id.org/rml/report#> .

rep:RmlEngineReport a rdfs:Class ;
    rdfs:label "RML Engine Report" ;
    rdfs:comment "A report generated by an RML engine." .

rep:hasStatistics a rdf:Property ;
    rdfs:label "has statistics" ;
    rdfs:domain rep:RmlEngineReport ;
    rdfs:range rep:Statistics .

rep:hasExecutionPlan a rdf:Property ;
    rdfs:label "has execution plan" ;
    rdfs:domain rep:RmlEngineReport ;
    rdfs:range rep:ExecutionPlan .

rep:hasError a rdf:Property ;
    rdfs:label "has error" ;
    rdfs:domain rep:RmlEngineReport ;
    rdfs:range rep:Error .

rep:hasWarning a rdf:Property ;
    rdfs:label "has warning" ;
    rdfs:domain rep:RmlEngineReport ;
    rdfs:range rep:Warning .

rep:Statistics a rdfs:Class ;
    rdfs:label "Statistics" ;
    rdfs:comment "Statistics about the RML engine execution." .

rep:generatedStatements a rdf:Property ;
    rdfs:label "generated statements" ;
    rdfs:domain rep:Statistics ;
    rdfs:range xsd:integer .

rep:generatedStatementsPerTarget a rdf:Property ;
    rdfs:label "generated statements per target" ;
    rdfs:domain rep:Statistics ;
    rdfs:range xsd:integer .

rep:generatedStatementsPerTM a rdf:Property ;
    rdfs:label "generated statements per Triples Map" ;
    rdfs:domain rep:Statistics ;
    rdfs:range xsd:integer .

rep:ExecutionPlan a rdfs:Class ;
    rdfs:label "Execution Plan" ;
    rdfs:comment "The execution plan used by the RML engine." .

rep:Error a rdfs:Class ;
    rdfs:label "Error" ;
    rdfs:comment "An error that occurred during the RML engine execution." .

rep:Warning a rdfs:Class ;
    rdfs:label "Warning" ;
    rdfs:comment "A warning that occurred during the RML engine execution." .

rep:potentialCause a rdf:Property ;
    rdfs:label "potential cause" ;
    rdfs:domain rep:Error ;
    rdfs:range rdfs:Literal .

rep:potentialSolution a rdf:Property ;
    rdfs:label "potential solution" ;
    rdfs:domain rep:Error ;
    rdfs:range rdfs:Literal .

rep:potentialConfusion a rdf:Property ;
    rdfs:label "potential confusion" ;
    rdfs:domain rep:Error ;
    rdfs:range rdfs:Literal .

rep:hasSourceNode a rdf:Property ;
    rdfs:label "has source node" ;
    rdfs:domain rep:Error ;
    rdfs:range rdf:Resource .

rep:hasMappingNode a rdf:Property ;
    rdfs:label "has mapping node" ;
    rdfs:domain rep:Error ;
    rdfs:range rdf:Resource .

rep:lineNumber a rdf:Property ;
    rdfs:label "line number" ;
    rdfs:domain rep:Error ;
    rdfs:range xsd:integer .

rep:colNumber a rdf:Property ;
    rdfs:label "column number" ;
    rdfs:domain rep:Error ;
    rdfs:range xsd:integer .

rep:hasSourceData a rdf:Property ;
    rdfs:label "has source data" ;
    rdfs:domain rep:Error ;
    rdfs:range rdfs:Literal .

# Error Taxonomy
rep:ExecutionError a rdfs:Class ;
    rdfs:label "Execution Error" ;
    rdfs:subClassOf rep:Error ;
    rdfs:comment "Errors related to the execution of a mapping (plan) with real data" ;
    rep:potentialCause "Hypothesis on data may be incorrect" ;
    rep:potentialSolution "If the data are corrcet then adapt setup to handle that case else change the data" ;
    rep:potentialConfusion "An error that could be captured with static analysis alone." .

rep:DataError a rdfs:Class ;
    rdfs:label "Data Error" ;
    rdfs:subClassOf rep:ExecutionError ;
    rdfs:comment "The obtained data is problematic." .

rep:TypeConversionError a rdfs:Class ;
    rdfs:label "Type Conversion Error" ;
    rdfs:subClassOf rep:DataError ;
    rdfs:comment "The type of a data could not be converted to the target type." ;
    rep:potentialCause "An ExpressionMap generates a value of a type that is not convertibe to the expected/specified type" .

rep:UnparseableDataError a rdfs:Class ;
    rdfs:label "Unparseable Data Error" ;
    rdfs:subClassOf rep:DataError ;
    rdfs:comment "The obtained data does not follow the expected format." .

rep:SourceAccessError a rdfs:Class ;
    rdfs:label "Source Access Error" ;
    rdfs:subClassOf rep:ExecutionError ;
    rdfs:comment "The specified rml:Source cannot be accessed/reched/does not exists." ;
    rep:potentialCause "Error in the acess path or credentials" .

rep:LogicalSourceError a rdfs:Class ;
    rdfs:label "Logical Source Error" ;
    rdfs:subClassOf rep:ExecutionError ;
    rdfs:comment "Error while obtaining an iteration or iterating over a source." ;
    rep:potentialCause "The reference formulation, iterator, is incompatible" .

rep:ReferenceFormulationExecutionError a rdfs:Class ;
    rdfs:label "Reference Formulation Execution Error" ;
    rdfs:subClassOf rep:ExecutionError ;
    rdfs:comment "Error while extracting value from Iteration" ;
    rep:potentialCause "reference expression is incorrect or " .

rep:FunctionExecutionError a rdfs:Class ;
    rdfs:label "Function Execution Error" ;
    rdfs:subClassOf rep:ExecutionError ;
    rep:potentialConfusion "Type Conversion Error could be an alternative when we prescisly know that's the issue." .

rep:InvalidRDF a rdfs:Class ;
    rdfs:label "Invalid RDF" ;
    rdfs:subClassOf rep:ExecutionError ;
    rep:potentialConfusion "This error is not for mapping file with errors in the RDF serialization format, these should be Mapping Syntax Error." .

rep:InvalidIRI a rdfs:Class ;
    rdfs:label "Invalid IRI" ;
    rdfs:subClassOf rep:InvalidRDF .

rep:PredicateNotReifiable a rdfs:Class ;
    rdfs:label "Predicate Not Reifiable" ;
    rdfs:subClassOf rep:InvalidRDF .

rep:MappingError a rdfs:Class ;
    rdfs:label "Mapping Error" ;
    rdfs:subClassOf rep:Error ;
    rdfs:comment "Errors related to the mapping definition itself. Changing input data or configuartion will not make it work." ;
    rep:potentialCause "The RML mapping is invalid." ;
    rep:potentialSolution "Changing the mapping." ;
    rep:potentialConfusion "The error is not due to the data in which case it is probably an Execution Error or Configuration Error." .

rep:RDFMappingSyntaxError a rdfs:Class ;
    rdfs:label "RDF Mapping Syntax Error" ;
    rdfs:subClassOf rep:MappingError ;
    rdfs:comment "Error in the RDF Serialization of the mapping." .

rep:UnsupportedMapping a rdfs:Class ;
    rdfs:label "Unsupported Mapping" ;
    rdfs:subClassOf rep:MappingError ;
    rdfs:comment "For cases when the engin does not implement part of the spec." ;
    rep:potentialConfusion "The difference with Out Of Spec is that the engin don't know it this is spec compliant or not." .

rep:UnsupportedFunction a rdfs:Class ;
    rdfs:label "Unsupported Function" ;
    rdfs:subClassOf rep:UnsupportedMapping ;
    rdfs:comment "Special case of Unsuported for functions, calling a function name without an implementation by the engin. The call may be valid." ;
    rep:potentialSolution "Add the implementation to the engin, setup a custom function for the engin or change engin." ;
    rep:potentialConfusion "Not to be confused with Function Execution Error where the function itslef is implemeted but had an issue while executing." .

rep:OutOfSpec a rdfs:Class ;
    rdfs:label "Out Of Spec" ;
    rdfs:subClassOf rep:MappingError ;
    rdfs:comment "Optional addittional checks by the engin for constrcut clearly out of spec unspecified or forbidden" ;
    rep:potentialCause "Somthing is missing in the mapping. Likely to be catched by the shapes." .

rep:ReferenceFormulationSyntaxError a rdfs:Class ;
    rdfs:label "Reference Formulation Syntax Error" ;
    rdfs:subClassOf rep:MappingError .

rep:NoTriplesMap a rdfs:Class ;
    rdfs:label "No Triples Map" ;
    rdfs:subClassOf rep:MappingError ;
    rdfs:comment "No triples map foud in the graph." ;
    rep:potentialCause "Wrong prefix used or empty mapping file." .
