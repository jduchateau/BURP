package burp.reporting

import burp.vocabularies.RER
import org.apache.jena.rdf.model.Model
import org.apache.jena.rdf.model.ModelFactory
import org.apache.jena.rdf.model.Resource
import org.apache.jena.vocabulary.RDF
import java.io.FileWriter


fun generateRdfReport(report: RmlEngineReport, outputFile: String) {
    val model = ModelFactory.createDefaultModel()
    val reportResource = model.createResource(RER.RmlEngineReport)
    model.add(reportResource, RDF.type, RER.RmlEngineReport)

    fun addTracingInfo(model: Model, resource: Resource, origin: Origin?) {
        origin?.let {
            it.location?.start?.let { start ->
                model.add(resource, RER.lineNumber, model.createTypedLiteral(start.line))
                model.add(resource, RER.colNumber, model.createTypedLiteral(start.column))
            }
            it.sourceNode?.let { sn ->
                model.add(resource, RER.hasSourceNode, sn)
            }
        }
    }

    fun addIssue(
        model: Model,
        reportResource: Resource,
        issue: Report,
        isError: Boolean
    ) {
        val resource = model.createResource()
        if (isError) {
            val error = issue as RmlError
            model.add(reportResource, RER.hasError, resource)
            model.add(resource, RDF.type, error.errorType)
            model.add(resource, RER.message, error.message)
            addTracingInfo(model, resource, error.origin)
        } else {
            val warning = issue as Warning
            model.add(reportResource, RER.hasWarning, resource)
            model.add(resource, RDF.type, RER.Warning)
            model.add(resource, RER.message, warning.message)
            addTracingInfo(model, resource, warning.origin)
        }
    }

    // Replace the original error and warning loops with:
    report.errors.forEach { error ->
        addIssue(model, reportResource, error, true)
    }

    report.warnings.forEach { warning ->
        addIssue(model, reportResource, warning, false)
    }

    if (report.statistics != null) {
        val statisticsResource = model.createResource()
        model.add(reportResource, RER.hasStatistics, statisticsResource)
        model.add(statisticsResource, RDF.type, RER.Statistics)
        model.add(statisticsResource, RER.generatedStatements, report.statistics.generatedStatements.toString())
    }

    if (report.executionPlan.isNotEmpty()) {
        val executionPlanResource = model.createResource()
        model.add(reportResource, RER.hasExecutionPlan, executionPlanResource)
        model.add(executionPlanResource, RDF.type, RER.ExecutionPlan)
        model.add(
            executionPlanResource,
            RER.numberOfTriplesMap,
            model.createTypedLiteral(report.executionPlan.size)
        )
    }

    model.write(FileWriter(outputFile), "TURTLE")
}

